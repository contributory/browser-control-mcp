# Copy to .env and fill in locally. Never commit real values.
# Only names and non-secret sample values belong in this file.
# The server reads the process environment; load this file with
# `node --env-file=.env dist/index.js` or your process manager.

# --- MCP transport -----------------------------------------------------------
# Required. Comma-separated list of bearer tokens (16+ chars each); the matching
# token identifies the principal that owns browser sessions.
MCP_AUTH_TOKEN=replace-with-at-least-16-random-characters
# Optional stateless OAuth for ChatGPT and other MCP clients.
# Use the canonical public HTTPS origin (no /mcp suffix).
# MCP_OAUTH_ISSUER=https://mcp.example.com
# Extra exact HTTPS OAuth callback URLs, comma-separated.
# The documented ChatGPT callbacks are already allowed.
MCP_OAUTH_REDIRECT_URIS=
# Browser origins allowed to call /mcp. Leave empty to accept requests without
# an Origin header only (non-browser clients).
MCP_ALLOWED_ORIGINS=https://app.example.com
HOST=127.0.0.1
PORT=3000
# Largest accepted JSON request body and per-request socket timeout.
MCP_MAX_REQUEST_BYTES=262144
MCP_REQUEST_TIMEOUT_MS=60000

# --- Destination policy ------------------------------------------------------
# Allowlisted navigation/render origins. Entries are scheme://host[:port] or
# scheme://*.example.com. Empty keeps public HTTP(S) usable and blocks private,
# loopback and link-local addresses.
BROWSER_ALLOWED_ORIGINS=https://app.example.com,https://*.docs.example.com
# Restrict which configured services may be opened. Empty means all configured.
BROWSER_ALLOWED_SERVICES=hyperbrowser,browsercloud,phantomjscloud

# --- Session limits ----------------------------------------------------------
BROWSER_SESSION_IDLE_TTL_MS=300000
BROWSER_SESSION_MAX_LIFETIME_MS=900000
BROWSER_CONNECT_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_MAX_SESSIONS_PER_PRINCIPAL=2
BROWSER_MAX_SESSIONS_TOTAL=8
BROWSER_MAX_PAGES=1
BROWSER_MAX_OUTPUT_BYTES=65536
BROWSER_MAX_IMAGE_BYTES=1500000
BROWSER_MAX_ACTION_STEPS=12
BROWSER_MAX_WAIT_MS=5000

# --- Diagnostics -------------------------------------------------------------
BROWSER_DIAGNOSTIC_MAX_ENTRIES=200
BROWSER_DIAGNOSTIC_TTL_MS=300000
BROWSER_CDP_MAX_SUBSCRIPTIONS=4
BROWSER_CDP_MAX_BYTES=32768
# Privileged capabilities, off by default.
BROWSER_ENABLE_EVALUATE=false
BROWSER_ENABLE_CDP=false

# --- Providers (values are secrets; leave blank in the example) --------------
# Optional server-only handle secret for provider-managed sessions.
# Defaults to a domain-separated derivation from HYPERBROWSER_API_KEY.
# Never set this to a client bearer token.
BROWSER_SESSION_SECRET=
HYPERBROWSER_API_KEY=
BROWSERCLOUD_TOKEN=
# Optional endpoint override; defaults to wss://chrome-v2.browsercloud.io/
BROWSERCLOUD_ENDPOINT=
PHANTOMJSCLOUD_API_KEY=
# Optional endpoint override; defaults to https://phantomjscloud.com/api/browser/v2
PHANTOMJSCLOUD_ENDPOINT=

# Custom CDP endpoint. The suffix becomes the lowercase service name.
# PLAYWRIGHT_CDP_MY_BROWSER=wss://browser.example.com/devtools/browser/your-session
